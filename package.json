{
  "name": "anidesk",
  "version": "1.2.0",
  "description": "ANIDESK - Next-Gen Anime Streaming Experience",
  "main": "dist-electron/main.js",
  "author": "ANIDESK Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAADALAHSAN/anidesk.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "desktop": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run electron:build && electron .\"",
    "desktop:preview": "npm run build && npm run electron:build && electron .",
    "pack": "npm run build && npm run electron:build && electron-builder --dir",
    "dist": "npm run build && npm run electron:build && electron-builder"
  },
  "keywords": [
    "anime",
    "desktop",
    "streaming",
    "windows",
    "player",
    "4k"
  ],
  "license": "MIT",
  "dependencies": {
    "hls.js": "^1.5.17",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "net.anidesk.app",
    "productName": "ANIDESK",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SAADALAHSAN",
        "repo": "anidesk"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ANIDESK",
      "uninstallDisplayName": "ANIDESK",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ]
  }
}
